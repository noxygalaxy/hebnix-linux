# Maintainer: xplodingeggo <bugs@notmyproblem.cum>
pkgname=hebnix-linux
pkgver=0.2.0
pkgrel=1
pkgdesc="Rocket League overlay, stats tracker and item-changer for Linux (Hyprland/wlroots), built from source"
arch=('x86_64')
url="https://github.com/xplodingeggo/hebnix-linux"
# Custom license (pulled from github.com/Hebbins/Hebnix-Public/LICENSE.md,
# 2026-09-02) -- terms are Apache-2.0 verbatim under the name "Hebnix
# License, Version 1.0", properly filled in (Copyright 2026 Hebnix). Not
# literally SPDX Apache-2.0 since the license itself renames and
# re-titles the grant, so using LicenseRef- per Arch's SPDX migration
# guidance; the actual text is shipped below.
license=('LicenseRef-Hebnix')
depends=(
	'gtk3'
	'systemd-libs'
	'alsa-lib'
	'openssl'
	'xdotool'
	'webkit2gtk-4.1'
	'gtk-layer-shell'
	# Not in hebnix's own ELF NEEDED list (verified with `readelf -d`) --
	# the wayland-client/xkbcommon-dl/tray-icon crates dlopen these at
	# runtime rather than link-time linking, specifically so the binary
	# still starts on a system without them. They ARE genuinely required
	# for the Wayland overlay, keyboard handling, and tray icon to work,
	# so `namcap`'s "may not be needed" warning for these three is a false
	# positive (dlopen isn't visible to static ELF analysis) -- kept
	# deliberately, not an oversight.
	'wayland'
	'libxkbcommon'
	'libayatana-appindicator'
)
makedepends=('rust' 'pkgconf')
# ring and mlua's vendored Lua compile a small amount of C/asm through the
# `cc` crate, which picks up $CFLAGS. If the builder has makepkg's `lto`
# option enabled, that C code gets built with GCC LTO bytecode objects
# that rustc's linker (ld.lld) can't resolve symbols from -- disable it
# for this package specifically rather than relying on every builder's
# local makepkg.conf.
options=('!lto')
optdepends=(
	'kdotool: window focus tracking on KDE/Plasma (AUR)'
	'picom: compositing manager for the in-game overlay on i3 and other X11 window managers without one'
	'kscreen: kscreen-doctor, used for monitor info on KDE/Plasma'
	'tailscale: Workshop LAN multiplayer (Hebnix runs its own separate tailscaled)'
	'dotnet-runtime: downloading Steam Workshop maps in the Import Map tab'
)
provides=('hebnix')
conflicts=('hebnix-linux-bin')
install=hebnix.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/xplodingeggo/hebnix-linux/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
	cd "hebnix-linux-$pkgver"
	# Canonical build path -- same `make release` used locally and by CI.
	make release
}

check() {
	cd "hebnix-linux-$pkgver"
	make check
}

package() {
	cd "hebnix-linux-$pkgver"
	# Canonical install path, DESTDIR/PREFIX-aware -- installs
	# /usr/bin/hebnix, the .desktop file, and the icon. Never touches
	# $HOME: plugins/themes/config are created by Hebnix itself at
	# $XDG_CONFIG_HOME/hebnix on first run.
	make DESTDIR="$pkgdir" PREFIX=/usr install

	install -Dm644 packaging/udev/60-hebnix-uinput.rules \
		"$pkgdir/usr/lib/udev/rules.d/60-hebnix-uinput.rules"
	install -Dm644 packaging/modules-load.d/hebnix-uinput.conf \
		"$pkgdir/usr/lib/modules-load.d/hebnix-uinput.conf"
	install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
